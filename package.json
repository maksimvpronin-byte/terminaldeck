{
  "name": "terminaldeck",
  "version": "0.5.1",
  "description": "Cross-platform SSH/SFTP terminal manager (MobaXterm/Royal TSX alternative)",
  "main": "./out/main/index.js",
  "author": "TerminalDeck",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "install-electron && electron-vite preview",
    "build:mac": "npm run build:freerdp:bundle && electron-vite build && electron-builder --mac",
    "build:mac:dir": "npm run build:freerdp:bundle && electron-vite build && electron-builder --mac dir",
    "build:shadowhost": "powershell -NoProfile -ExecutionPolicy Bypass -File resources/shadowhost/build.ps1",
    "build:freerdp:mac": "bash resources/freerdp/build-macos.sh",
    "build:freerdp:shim": "bash resources/freerdp/build-shim.sh",
    "build:freerdp:bundle": "bash resources/freerdp/bundle-macos.sh",
    "build:freerdp:win": "powershell -NoProfile -ExecutionPolicy Bypass -File resources/freerdp/build-windows.ps1",
    "build:freerdp:win:shim": "powershell -NoProfile -ExecutionPolicy Bypass -File resources/freerdp/build-windows.ps1 -ShimOnly",
    "build:freerdp:win:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File resources/freerdp/bundle-windows.ps1",
    "build:win": "npm run build:shadowhost && npm run build:freerdp:win:bundle && electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maksimvpronin-byte/terminaldeck.git"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "nanoid": "^5.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "ws": "^8.21.3",
    "yaml": "^2.6.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
