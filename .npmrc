# Resolve only declared dependencies. omit=peer left the unused Squirrel.Windows
# packager in package-lock.json, so scanners which reconstruct that tree still
# downloaded electron-winstaller's old 7-Zip executables. This app builds NSIS
# and portable targets and does not use Squirrel.Windows.
#
# npm will not install or validate peers automatically. Required peers must be
# declared explicitly, as @testing-library/dom is for @testing-library/react.
# CI verifies the dependency tree and runs the build on the supported platforms.
legacy-peer-deps=true
