<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron needs these under the hardened runtime; without them the app
         crashes on launch once it is signed and notarized. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- The desktop client is a program of its own, in Resources, and it loads
         the FreeRDP libraries bundled beside it. Under the hardened runtime a
         process may otherwise only load libraries signed by the same team, and
         these are built from source here rather than signed by anyone. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound SSH/SFTP connections. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Local listeners for local and dynamic (SOCKS) port forwarding. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Reading private keys and ~/.ssh/config, saving downloads. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
